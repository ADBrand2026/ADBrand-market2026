          </button>

        </div>

        <div class="ad-content">

          <h3>Premium Smartphone</h3>

          <div class="price">₹28,999</div>

          <div class="ad-location">
            📍 Gomti Nagar, Lucknow
          </div>

          <div class="ad-footer">
            <span>📱 Mobiles</span>
            <span>Today</span>
          </div>

        </div>

      </div>


      <!-- AD 2 -->

      <div class="ad-card" data-category="Cars">

        <div class="ad-image">

          <img
            src="https://images.unsplash.com/photo-1550355291-bbee04a92027?auto=format&fit=crop&w=700&q=80"
            alt="Car"
          />

          <span class="badge">FEATURED</span>

          <button class="heart" onclick="favorite(this)">
            ♡
          </button>

        </div>

