            alt="House"
          />

          <span class="badge">PREMIUM</span>

          <button class="heart" onclick="favorite(this)">
            ♡
          </button>

        </div>

        <div class="ad-content">

          <h3>Modern 3 BHK House</h3>

          <div class="price">₹78 Lakh</div>

          <div class="ad-location">
            📍 Indira Nagar, Lucknow
          </div>

          <div class="ad-footer">
            <span>🏠 Property</span>
            <span>Yesterday</span>
          </div>

        </div>

      </div>


      <!-- AD 4 -->

      <div class="ad-card" data-category="Electronics">

        <div class="ad-image">

          <img
            src="https://images.unsplash.com/photo-1606813907291-d86efa9b94db?auto=format&fit=crop&w=700&q=80"
            alt="Laptop"
          />

          <span class="badge">FEATURED</span>

          <button class="heart" onclick="favorite(this)">
            ♡
          </button>

        </div>

        <div class="ad-content">

          <h3>Gaming Laptop</h3>

          <div class="price">₹62,000</div>

          <div class="ad-location">
            📍 Hazratganj, Lucknow
          </div>

          <div class="ad-footer">
            <span>💻 Electronics</span>
            <span>3 days ago</span>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ================= LOCAL BRANDS ================= -->

  <section class="container">

    <div class="section-header">
      <h2>Popular Local Brands</h2>
      <a href="#" class="view-all">Explore Brands →</a>
    </div>

    <div class="brands">

      <div class="brand">
        <div class="brand-logo">A</div>
        <h3>Alpha Fashion</h3>
        <p>Fashion & Clothing</p>
