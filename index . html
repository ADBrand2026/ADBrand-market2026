<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>LocalBazaar - Local Marketplace</title>

  <meta
    name="description"
    content="LocalBazaar - Buy, sell, discover local products, services and brands near you."
  />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #ff5a1f;
      --primary-dark: #e94810;
      --secondary: #111827;
      --text: #1f2937;
      --muted: #6b7280;
      --bg: #f5f7fb;
      --white: #ffffff;
      --border: #e5e7eb;
      --green: #16a34a;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --radius: 16px;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    input,
    select {
      font: inherit;
    }

    /* ================= HEADER ================= */

    header {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .navbar {
      max-width: 1200px;
      margin: auto;
      min-height: 72px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      gap: 25px;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
      color: var(--secondary);
      white-space: nowrap;
    }

    .logo span {
      color: var(--primary);
    }

    .location {
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
      font-size: 14px;
      white-space: nowrap;
    }

    .search-box {
      flex: 1;
      display: flex;
      background: #f3f4f6;
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      max-width: 500px;
    }

    .search-box input {
      width: 100%;
      border: none;
      outline: none;
      padding: 13px 15px;
      background: transparent;
    }

    .search-box button {
      border: none;
      background: var(--primary);
      color: white;
      padding: 0 20px;
      cursor: pointer;
      font-weight: 700;
    }

    .search-box button:hover {
      background: var(--primary-dark);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-left: auto;
    }

    .nav-links a {
      font-size: 14px;
      font-weight: 600;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .login-btn {
      border: 1px solid var(--border);
      padding: 9px 15px;
      border-radius: 8px;
    }

    .post-btn {
      background: var(--primary);
      color: white;
      padding: 11px 17px;
      border-radius: 8px;
    }

    .post-btn:hover {
      color: white !important;
      background: var(--primary-dark);
    }

    .menu-btn {
      display: none;
      border: none;
      background: none;
      font-size: 25px;
      cursor: pointer;
    }

    /* ================= HERO ================= */

    .hero {
      background:
        linear-gradient(135deg, rgba(17, 24, 39, 0.96), rgba(31, 41, 55, 0.92)),
        url("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=80")
        center/cover;
      color: white;
      padding: 75px 20px;
    }

    .hero-content {
      max-width: 1000px;
      margin: auto;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(34px, 5vw, 58px);
      line-height: 1.1;
      margin-bottom: 18px;
    }

    .hero h1 span {
      color: #ff7a45;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: #d1d5db;
      font-size: 18px;
      margin-bottom: 30px;
    }

    .hero-search {
      max-width: 760px;
      margin: auto;
      background: white;
      border-radius: 12px;
      padding: 7px;
      display: flex;
      gap: 7px;
    }

    .hero-search input,
    .hero-search select {
      border: none;
      outline: none;
      padding: 14px;
      background: white;
      color: var(--text);
    }

    .hero-search input {
      flex: 1;
    }

    .hero-search select {
      width: 180px;
      border-left: 1px solid var(--border);
    }

    .hero-search button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 0 25px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
    }

    /* ================= CONTAINER ================= */

    .container {
      max-width: 1200px;
      margin: auto;
      padding: 55px 20px;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 25px;
    }

    .section-header h2 {
      font-size: 28px;
    }

    .view-all {
      color: var(--primary);
      font-weight: 700;
      font-size: 14px;
    }

    /* ================= CATEGORIES ================= */

    .categories {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 15px;
    }

    .category {
      background: white;
      padding: 20px 10px;
      border-radius: var(--radius);
      text-align: center;
      border: 1px solid var(--border);
      cursor: pointer;
      transition: 0.25s;
    }

    .category:hover {
      transform: translateY(-5px);
      border-color: var(--primary);
      box-shadow: var(--shadow);
    }

    .category-icon {
      width: 55px;
      height: 55px;
      margin: auto auto 10px;
      border-radius: 50%;
      background: #fff1eb;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }

    .category h3 {
      font-size: 14px;
      margin-bottom: 4px;
    }

    .category p {
      color: var(--muted);
      font-size: 11px;
    }

    /* ================= ADS ================= */

    .ads-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .ad-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: 0.25s;
    }

    .ad-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
    }

    .ad-image {
      height: 200px;
      position: relative;
      overflow: hidden;
      background: #eee;
    }

    .ad-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: 0.4s;
    }

    .ad-card:hover .ad-image img {
      transform: scale(1.05);
    }

    .badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--primary);
      color: white;
      padding: 5px 9px;
      font-size: 11px;
      border-radius: 5px;
      font-weight: bold;
    }

    .heart {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: none;
      background: white;
      cursor: pointer;
      font-size: 18px;
    }

    .ad-content {
      padding: 17px;
    }

    .ad-content h3 {
      font-size: 17px;
      margin-bottom: 7px;
    }

    .price {
      color: var(--primary);
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 7px;
    }

    .ad-location {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 12px;
    }

    .ad-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--muted);
      font-size: 12px;
      padding-top: 10px;
      border-top: 1px solid var(--border);
    }

    /* ================= BRANDS ================= */

    .brands {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
    }

    .brand {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 25px 15px;
      text-align: center;
      transition: 0.25s;
    }

    .brand:hover {
      box-shadow: var(--shadow);
      transform: translateY(-4px);
    }

    .brand-logo {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: #f3f4f6;
      margin: auto auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: bold;
    }

    .brand h3 {
      font-size: 16px;
      margin-bottom: 5px;
    }

    .brand p {
      font-size: 12px;
      color: var(--muted);
    }

    /* ================= LOCAL BUSINESSES ================= */

    .business-section {
      background: white;
    }

    .business-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .business-card {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      display: flex;
      gap: 15px;
      background: white;
    }

    .business-logo {
      width: 65px;
      height: 65px;
      min-width: 65px;
      border-radius: 12px;
      background: #fff1eb;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 28px;
    }

    .business-card h3 {
      font-size: 17px;
      margin-bottom: 4px;
    }

    .business-card p {
      color: var(--muted);
      font-size: 13px;
    }

    .rating {
      color: #f59e0b;
      font-size: 13px;
      margin-top: 5px;
    }

    /* ================= CTA ================= */

    .cta {
      margin: 0 auto 60px;
      max-width: 1160px;
      padding: 55px 30px;
      border-radius: 20px;
      background: linear-gradient(135deg, #ff5a1f, #ff7a45);
      color: white;
      text-align: center;
    }

    .cta h2 {
      font-size: 34px;
      margin-bottom: 10px;
    }

    .cta p {
      margin-bottom: 25px;
      color: #fff3ed;
    }

    .cta button {
      background: white;
      color: var(--primary);
      border: none;
      padding: 13px 25px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #111827;
      color: white;
      padding: 55px 20px 25px;
    }

    .footer-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
    }

    .footer-logo {
      font-size: 25px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .footer-logo span {
      color: var(--primary);
    }

    .footer-about {
      color: #9ca3af;
      max-width: 350px;
      font-size: 14px;
    }

    footer h3 {
      margin-bottom: 15px;
      font-size: 16px;
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin-bottom: 10px;
    }

    footer li a {
      color: #9ca3af;
      font-size: 14px;
    }

    footer li a:hover {
      color: white;
    }

    .copyright {
      max-width: 1200px;
      margin: 40px auto 0;
      padding-top: 20px;
      border-top: 1px solid #374151;
      color: #9ca3af;
      font-size: 13px;
      text-align: center;
    }

    /* ================= MODAL ================= */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal.active {
      display: flex;
    }

    .modal-box {
      background: white;
      max-width: 480px;
      width: 100%;
      padding: 30px;
      border-radius: 16px;
      position: relative;
    }

    .close-modal {
      position: absolute;
      top: 12px;
      right: 15px;
      border: none;
      background: none;
      font-size: 25px;
      cursor: pointer;
    }

    .modal-box h2 {
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      outline: none;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }

    .submit-btn {
      width: 100%;
      border: none;
      background: var(--primary);
      color: white;
      padding: 13px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 1000px) {
      .categories {
        grid-template-columns: repeat(4, 1fr);
      }

      .ads-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .brands {
        grid-template-columns: repeat(3, 1fr);
      }

      .business-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .nav-links {
        gap: 10px;
      }
    }

    @media (max-width: 750px) {
      .navbar {
        flex-wrap: wrap;
        padding: 12px 15px;
      }

      .location {
        display: none;
      }

      .search-box {
        order: 3;
        flex-basis: 100%;
        max-width: none;
      }

      .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        padding-bottom: 10px;
      }

      .nav-links.active {
        display: flex;
      }

      .nav-links a {
        padding: 10px;
      }

      .menu-btn {
        display: block;
        margin-left: auto;
      }

      .hero {
        padding: 55px 15px;
      }

      .hero-search {
        flex-direction: column;
      }

      .hero-search select {
        width: 100%;
        border-left: none;
        border-top: 1px solid var(--border);
      }

      .hero-search button {
        padding: 14px;
      }

      .categories {
        grid-template-columns: repeat(2, 1fr);
      }

      .ads-grid {
        grid-template-columns: 1fr;
      }

      .brands {
        grid-template-columns: repeat(2, 1fr);
      }

      .business-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .section-header h2 {
        font-size: 22px;
      }

      .brands {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .cta h2 {
        font-size: 27px;
      }
    }
  </style>
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header>
    <nav class="navbar">

      <a href="#" class="logo">
        Local<span>Bazaar</span>
      </a>

      <div class="location">
        📍 <span>Lucknow</span>
      </div>

      <div class="search-box">
        <input
          type="text"
          id="topSearch"
          placeholder="Search products, brands, services..."
        />
        <button onclick="searchItems()">Search</button>
      </div>

      <button class="menu-btn" onclick="toggleMenu()">☰</button>

      <div class="nav-links" id="navLinks">
        <a href="#categories">Categories</a>
        <a href="#ads">Explore</a>
        <a href="#businesses">Businesses</a>
        <a href="#" class="login-btn" onclick="openModal('loginModal')">
          Login
        </a>
        <a href="#" class="post-btn" onclick="openModal('postModal')">
          + Post Ad
        </a>
      </div>

    </nav>
  </header>


  <!-- ================= HERO ================= -->

  <section class="hero">

    <div class="hero-content">

      <h1>
        Discover What's
        <span>Local</span>
      </h1>

      <p>
        Buy, sell and discover products, services and local brands
        around your city.
      </p>

      <div class="hero-search">

        <input
          type="text"
          id="heroSearch"
          placeholder="What are you looking for?"
        />

        <select id="categorySearch">
          <option value="">All Categories</option>
          <option>Mobiles</option>
          <option>Cars</option>
          <option>Property</option>
          <option>Jobs</option>
          <option>Fashion</option>
          <option>Electronics</option>
          <option>Services</option>
          <option>Food</option>
        </select>

        <button onclick="heroSearch()">
          🔍 Search
        </button>

      </div>

    </div>

  </section>


  <!-- ================= CATEGORIES ================= -->

  <section class="container" id="categories">

    <div class="section-header">
      <h2>Popular Categories</h2>
      <a href="#" class="view-all">View All →</a>
    </div>

    <div class="categories">

      <div class="category" onclick="filterCategory('Mobiles')">
        <div class="category-icon">📱</div>
        <h3>Mobiles</h3>
        <p>12K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Cars')">
        <div class="category-icon">🚗</div>
        <h3>Cars</h3>
        <p>8K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Property')">
        <div class="category-icon">🏠</div>
        <h3>Property</h3>
        <p>5K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Jobs')">
        <div class="category-icon">💼</div>
        <h3>Jobs</h3>
        <p>15K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Fashion')">
        <div class="category-icon">👕</div>
        <h3>Fashion</h3>
        <p>6K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Electronics')">
        <div class="category-icon">💻</div>
        <h3>Electronics</h3>
        <p>9K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Services')">
        <div class="category-icon">🔧</div>
        <h3>Services</h3>
        <p>7K+ Ads</p>
      </div>

      <div class="category" onclick="filterCategory('Food')">
        <div class="category-icon">🍔</div>
        <h3>Food</h3>
        <p>3K+ Ads</p>
      </div>

    </div>

  </section>


  <!-- ================= FEATURED ADS ================= -->

  <section class="container" id="ads">

    <div class="section-header">
      <h2>Featured Ads</h2>
      <a href="#" class="view-all">View All →</a>
    </div>

    <div class="ads-grid" id="adsGrid">

      <!-- AD 1 -->

      <div class="ad-card" data-category="Mobiles">

        <div class="ad-image">

          <img
